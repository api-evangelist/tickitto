      "item": [
        {
          "id": "377c1b50-d620-4bfe-9f6e-de17048a5b68",
          "name": "Search For Events",
          "request": {
            "name": "Search For Events",
            "description": {
              "content": "Searches for events from the Tickitto inventory and provides additional metadata about the search result. \n\nThe search endpoint is meant for use with the Tickitto website. \n\nThe search endpoint supports text search as well as filters for different event categories, cities, or countries to create a powerful contextual search experience. \n\nThe endpoint supports pagination via the `skip` and `limit` parameters and the returned `X-Total-Count` header.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "search",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "t1",
                  "value": "<date>",
                  "description": "Start of the date range in which returned events should have availability. Defaults to today."
                },
                {
                  "disabled": false,
                  "key": "t2",
                  "value": "<date>",
                  "description": "End of the date range in which returned events should have availability. Defaults to 14 days from now."
                },
                {
                  "disabled": false,
                  "key": "min_price",
                  "value": "<number>",
                  "description": "The minimum price to restrict the query to."
                },
                {
                  "disabled": false,
                  "key": "max_price",
                  "value": "<number>",
                  "description": "The maximum price to restrict the query to."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "<string>",
                  "description": "The min/max price currency to use when using price-based query restrictions"
                },
                {
                  "disabled": false,
                  "key": "text",
                  "value": "",
                  "description": "Text to perform a search of events with."
                },
                {
                  "disabled": false,
                  "key": "partial_match",
                  "value": "false",
                  "description": "Perform partial/substring text matching, includes fuzzy search (max 1 character change). Algolia search always performs partial/substring text matching."
                },
                {
                  "disabled": false,
                  "key": "skip",
                  "value": "<integer>",
                  "description": "Number of results to skip for pagination; see also `limit` and the `X-Total-Count` response header."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Number of results to return for pagination; see also `skip` and the `X-Total-Count` response header."
                },
                {
                  "disabled": false,
                  "key": "sort_by",
                  "value": "<string>",
                  "description": "Sort order to use.If not specified, the default sort order is textual relevance if applicable, else geographical distance if applicable, else an arbitrary stable order."
                },
                {
                  "disabled": false,
                  "key": "event_ids",
                  "value": "<string>",
                  "description": "List of event IDs to retrieve."
                },
                {
                  "disabled": false,
                  "key": "event_ids",
                  "value": "<string>",
                  "description": "List of event IDs to retrieve."
                },
                {
                  "disabled": false,
                  "key": "should_raise",
                  "value": "false"
                },
                {
                  "disabled": false,
                  "key": "profile_name",
                  "value": "<string>",
                  "description": "Profile name"
                },
                {
                  "disabled": false,
                  "key": "hostname",
                  "value": "<string>",
                  "description": "Associated hostname"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
