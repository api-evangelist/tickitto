      },
      "item": [
        {
          "id": "6f593cbd-58c3-4215-8ca2-6110009f13ad",
          "name": "Fetch Availability For An Event",
          "request": {
            "name": "Fetch Availability For An Event",
            "description": {
              "content": "This endpoint returns a URL to Tickitto's Ticket Selection Widget for the event being searched.\n\nThe Widgets are availability aware and load in real-time what seats, dates, and times are available to be selected for that event.\n\nAny additional selection required for add ons, pickup points, or concessions will be displayed in the Widget.\n\nYou will need to pass the event_id and a basket_id with this endpoint. To generate a basket_id, you will need to first create a basket by making a POST request to the create\nbasket endpoint.\n\nWhen the ticket buyer selects a ticket via the Widget, they will then need to invoke the 'add to basket' action. This action will add the chosen ticket(s) to the basket_id\nassociated with that widget URL.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "availability",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "event_id",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "basket_id",
                  "value": "<string>",
                  "description": "REQUIRED FOR A VALID BOOKING FLOW. The ID of the basket associated with the current session. Only optional if you do not intend to add tickets to a basket using this availability session."
                },
                {
                  "disabled": false,
                  "key": "allow_cache",
                  "value": "false",
                  "description": "If true, allows reusing results which are up to 300.0 seconds old.The session is returned much faster but may contain old availabilities."
                },
                {
                  "disabled": false,
                  "key": "t1",
                  "value": "<date>",
                  "description": "Inclusive start of the date range from which to fetch initial availabilities."
                },
                {
                  "disabled": false,
                  "key": "t2",
                  "value": "<date>",
                  "description": "Inclusive end of the date range from which to fetch initial availabilities."
                },
                {
                  "disabled": false,
                  "key": "profile_name",
                  "value": "<string>",
                  "description": "Profile name"
                },
                {
                  "disabled": false,
                  "key": "hostname",
                  "value": "<string>",
                  "description": "Associated hostname"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "key": "origin",
                "value": "<string>",
                "description": ""
              },
              {
                "disabled": false,
                "description": "Optional transaction reference provided by the client. Used to correlate API requests and responses with client flow in logs, errors etc.",
                "key": "X-Correlation-ID",
                "value": "<string>"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "key"
                },
                {
                  "key": "value",
